function MessageBubble({ message }) {
  const isUser = message.role === \"user\";
  return (
    <div
      className={`flex ${isUser ? \"justify-end\" : \"justify-start\"} msg-enter`}
      data-testid={`message-${message.role}`}
    >
      {isUser ? (
        <div className=\"max-w-[80%] bg-black text-white p-4 text-sm leading-relaxed whitespace-pre-wrap\">
          {message.content}
        </div>
      ) : (
        <div className=\"max-w-[85%] flex gap-3\">
          <div className=\"w-8 h-8 bg-black text-white flex items-center justify-center shrink-0 mt-0.5\">
            <span className=\"font-display font-black text-xs tracking-tighter\">A</span>
          </div>
          <div className=\"bg-[#F4F4F5] border border-[#E4E4E7] p-4 text-sm leading-relaxed bot-content\">
            {renderBotContent(message.content)}
          </div>
        </div>
      )}
    </div>
  );
}

function TypingBubble() {
  return (
    <div className=\"flex justify-start msg-enter\" data-testid=\"typing-indicator\">
      <div className=\"max-w-[85%] flex gap-3\">
        <div className=\"w-8 h-8 bg-black text-white flex items-center justify-center shrink-0 mt-0.5\">
