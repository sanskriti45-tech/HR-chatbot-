function renderBotContent(text) {
  // Lightweight rendering: bold **text**, paragraphs, and bullet lines starting with - or *
  const lines = text.split(\"\n\");
  const out = [];
  let listBuffer = [];
  const flushList = (key) => {
    if (listBuffer.length) {
      out.push(
        <ul key={`ul-${key}`}>
          {listBuffer.map((li, i) => (
            <li key={i} dangerouslySetInnerHTML={{ __html: inlineFmt(li) }} />
          ))}
        </ul>,
      );
      listBuffer = [];
    }
  };
  const inlineFmt = (s) =>
    s
      .replace(/&/g, \"&amp;\")
      .replace(/</g, \"&lt;\")
      .replace(/>/g, \"&gt;\")
      .replace(/\*\*(.+?)\*\*/g, \"<strong>$1</strong>\")
      .replace(/`([^`]+)`/g, \"<code>$1</code>\");
  lines.forEach((line, idx) => {
    const trimmed = line.trim();
    if (/^[-*]\s+/.test(trimmed)) {
      listBuffer.push(trimmed.replace(/^[-*]\s+/, \"\"));
    } else if (trimmed === \"\") {
      flushList(idx);
      out.push(<div key={`sp-${idx}`} style={{ height: \"0.35rem\" }} />);
    } else {
      flushList(idx);
      out.push(<p key={idx} dangerouslySetInnerHTML={{ __html: inlineFmt(trimmed) }} />);
    }
  });
  flushList(\"end\");
  return out;
}

