        <div className=\"bg-[#F4F4F5] border border-[#E4E4E7] px-4 py-4 text-sm leading-relaxed flex items-center\">
          <span className=\"typing-dot\" />
          <span className=\"typing-dot\" />
          <span className=\"typing-dot\" />
        </div>
      </div>
    </div>
  );
}
