# ----- Models -----
class ChatSession(BaseModel):
    id: str
    title: str
    created_at: str
    updated_at: str

class ChatMessage(BaseModel):
    id: str
    session_id: str
    role: str  # 'user' | 'assistant'
    content: str
    created_at: str

class CreateSessionResponse(BaseModel):
    session: ChatSession

class SessionDetail(BaseModel):
    session: ChatSession
    messages: List[ChatMessage]

class SendMessageRequest(BaseModel):
    session_id: Optional[str] = None
    message: str

class SendMessageResponse(BaseModel):
    session_id: str
    user_message: ChatMessage
    assistant_message: ChatMessage

class Policy(BaseModel):
    id: str
    title: str
    icon: str
    summary: str
    details: List[str]


# ----- App -----
app = FastAPI()
api_router = APIRouter(prefix=\"/api\")


def _now() -> str:
    return datetime.now(timezone.utc).isoformat()


def _make_title(text: str) -> str:
    t = text.strip().split(\"\n\")[0]
    if len(t) > 48:
        t = t[:45] + \"...\"
    return t or \"New conversation\"


@api_router.get(\"/\")
async def root():
    return {\"message\": \"HR Assistant API\", \"status\": \"ok\"}


@api_router.get(\"/policies\", response_model=List[Policy])
async def get_policies():
    return [Policy(**p) for p in HR_POLICIES]


@api_router.post(\"/chat/sessions\", response_model=ChatSession)
async def create_session():
    session = {
        \"id\": str(uuid.uuid4()),
        \"title\": \"New conversation\",
        \"created_at\": _now(),
        \"updated_at\": _now(),
    }
    await db.chat_sessions.insert_one(session.copy())
    return ChatSession(**session)


@api_router.get(\"/chat/sessions\", response_model=List[ChatSession])
async def list_sessions():
    sessions = await db.chat_sessions.find({}, {\"_id\": 0}).sort(\"updated_at\", -1).to_list(200)
    return [ChatSession(**s) for s in sessions]


@api_router.get(\"/chat/sessions/{session_id}\", response_model=SessionDetail)
async def get_session(session_id: str):
    session = await db.chat_sessions.find_one({\"id\": session_id}, {\"_id\": 0})
    if not session:
        raise HTTPException(status_code=404, detail=\"Session not found\")
    messages = await db.chat_messages.find({\"session_id\": session_id}, {\"_id\": 0}).sort(\"created_at\", 1).to_list(1000)
    return SessionDetail(
        session=ChatSession(**session),
        messages=[ChatMessage(**m) for m in messages],
    )


@api_router.delete(\"/chat/sessions/{session_id}\")
async def delete_session(session_id: str):
    await db.chat_sessions.delete_one({\"id\": session_id})
    await db.chat_messages.delete_many({\"session_id\": session_id})
    return {\"deleted\": session_id}


@api_router.post(\"/chat/message\", response_model=SendMessageResponse)
async def send_message(req: SendMessageRequest):
    if not req.message or not req.message.strip():
        raise HTTPException(status_code=400, detail=\"Message cannot be empty\")

    # Resolve or create session
    session_id = req.session_id
    if session_id:
        session = await db.chat_sessions.find_one({\"id\": session_id}, {\"_id\": 0})
        if not session:
            raise HTTPException(status_code=404, detail=\"Session not found\")
    else:
        session = {
            \"id\": str(uuid.uuid4()),
            \"title\": _make_title(req.message),
            \"created_at\": _now(),
            \"updated_at\": _now(),
        }
        await db.chat_sessions.insert_one(session.copy())
        session_id = session[\"id\"]

    # Persist user message
    user_msg = {
        \"id\": str(uuid.uuid4()),
        \"session_id\": session_id,
        \"role\": \"user\",
        \"content\": req.message.strip(),
        \"created_at\": _now(),
    }
    await db.chat_messages.insert_one(user_msg.copy())

    # Build LLM chat with prior history
    history = await db.chat_messages.find(
        {\"session_id\": session_id}, {\"_id\": 0}
    ).sort(\"created_at\", 1).to_list(1000)

    chat = LlmChat(
        api_key=EMERGENT_LLM_KEY,
        session_id=session_id,
        system_message=SYSTEM_PROMPT,
    ).with_model(\"anthropic\", \"claude-sonnet-4-5-20250929\")

    # Send the latest user message; emergentintegrations manages history per session_id
    try:
        reply_text = await chat.send_message(UserMessage(text=req.message.strip()))
    except Exception as e:
        logger.error(f\"LLM error: {e}\")
        reply_text = (
            \"**Direct answer**\nI'm having trouble reaching the assistant service right now.\n\n\"
            \"**Escalation suggestion**\nPlease try again shortly, or email hr@company.com for urgent queries.\"
        )

    assistant_msg = {
        \"id\": str(uuid.uuid4()),
        \"session_id\": session_id,
        \"role\": \"assistant\",
        \"content\": str(reply_text),
        \"created_at\": _now(),
    }
    await db.chat_messages.insert_one(assistant_msg.copy())

    # Update session title if it's the first exchange + bump updated_at
    update_doc = {\"updated_at\": _now()}
    if len(history) <= 1:
        update_doc[\"title\"] = _make_title(req.message)
    await db.chat_sessions.update_one({\"id\": session_id}, {\"$set\": update_doc})

    return SendMessageResponse(
        session_id=session_id,
        user_message=ChatMessage(**user_msg),
        assistant_message=ChatMessage(**assistant_msg),
    )


